# Copy to .env.local. Never commit that file or reuse development secrets.
APP_ENV=local
SERVER_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/syncrate
# Generate independently per environment: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional server-side managed Base read endpoint; never expose its credentials.
BASE_RPC_URL=https://mainnet.base.org
# Required in preview/production. A verified identity-aware proxy must supply
# X-Syncrate-Identity containing a signed JWT with sub and amr including mfa.
CMS_IDENTITY_ISSUER=
CMS_IDENTITY_AUDIENCE=
CMS_IDENTITY_JWKS_URL=

# Copy to .env.local. Never commit that file or reuse development secrets.
APP_ENV=local
SERVER_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/syncrate
# Generate independently per environment: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional server-side managed Base read endpoint; never expose its credentials.
BASE_RPC_URL=https://mainnet.base.org
# Required for the default proxy identity mode in preview/production. A verified proxy supplies
# X-Syncrate-Identity containing a signed JWT with sub and amr including mfa.
CMS_IDENTITY_ISSUER=
CMS_IDENTITY_AUDIENCE=
CMS_IDENTITY_JWKS_URL=

# Supabase staff identity (server-only; no service_role key required).
# Preview uses a separate owner-designated Supabase project; never reuse production data.
# SERVER_URL may be omitted on Vercel Preview: the trusted VERCEL_BRANCH_URL (or VERCEL_URL) supplies it.
# CMS_AUTH_PROVIDER=supabase
# DATABASE_SCHEMA=cms
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Runtime DATABASE_URL uses syncrate_cms_runtime; migrations use the separate migrator.

# PEM root CA downloaded from the verified database provider dashboard.
# Required when that provider CA is not in the Node.js system trust store.
# Set the actual multiline PEM in the deployment configuration; this is not a private key.
DATABASE_CA_CERT=

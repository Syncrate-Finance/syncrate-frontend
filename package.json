{
  "name": "syncrate-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-force-exit --test-concurrency=1 tests/integration/*.test.ts",
    "payload": "payload",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:status": "payload migrate:status",
    "cms:bootstrap": "tsx scripts/bootstrap-cms.ts",
    "audit:production": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "geist": "1.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.105.0",
    "viem": "2.57.12",
    "wagmi": "2.19.5",
    "payload": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "graphql": "16.14.2",
    "sharp": "0.35.5",
    "jose": "6.2.13",
    "zod": "4.6.7",
    "dotenv": "18.0.9",
    "server-only": "0.0.1",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/extensions": "2.25.0",
    "@x402/svm": "2.25.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.62.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
